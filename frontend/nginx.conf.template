server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # Local convenience (docker compose). Not used behind the ALB.
    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
    }
}
